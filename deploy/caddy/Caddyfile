# Phase-0 skeleton. Replace both hostnames with real DNS names and place the
# Agent CA certificate at deploy/certs/agent-ca.pem (never commit it).

secrets.example.com {
	reverse_proxy core:8080
}

agents.example.com {
	# Pre-certificate routes: token enrollment, the install script, and
	# signed artifacts must be reachable before an Agent has a certificate.
	handle /agent/v1/enroll {
		reverse_proxy core:8080
	}
	handle /agent/v1/install.sh {
		reverse_proxy core:8080
	}
	handle /agent/v1/artifacts/* {
		reverse_proxy core:8080
	}
	# Everything else requires a client certificate from the internal CA
	# (ADR-0006); the serial is forwarded as the node identity.
	handle {
		tls {
			client_auth {
				mode require_and_verify
				trusted_ca_certs /certs/agent-ca.pem
			}
		}
		reverse_proxy core:8080 {
			header_up X-Autosecrets-Client-Cert {http.request.tls.client.certificate_serial}
		}
	}
}
